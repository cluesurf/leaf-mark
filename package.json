{
  "name": "@cluesurf/leaf-mark",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "make": "rm -rf host && tsc && tsc-alias",
    "scan": "rm -rf host && concurrently --kill-others \"tsc -w\" \"tsc-alias -w\"",
    "host": "pnpm make && npm publish --access=public"
  },
  "prettier": "@cluesurf/wash/flow.json",
  "devDependencies": {
    "@cluesurf/wash": "^0.6.10",
    "@types/node": "^22.15.3",
    "concurrently": "^7.6.0",
    "eslint": "^9.26.0",
    "tsc-alias": "^1.8.15",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
